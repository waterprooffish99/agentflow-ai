APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentflow
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentflow
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-very-long-random-secret-min-32-char
JWT_PREVIOUS_SECRET=
JWT_KID_CURRENT=v2
JWT_KID_PREVIOUS=v1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GEMINI_API_KEY=

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

AI_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_PER_MINUTE=500
AUTH_RATE_LIMIT_PER_MINUTE=30
PUBLIC_API_KEY=change-me
WIDGET_API_KEY=change-me

LOG_LEVEL=INFO
